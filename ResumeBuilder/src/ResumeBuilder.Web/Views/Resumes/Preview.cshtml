@model ResumeBuilder.Domain.Entities.Resume
@{
    ViewData["Title"] = "Resume Preview";
    var themeClass = Model.IsDarkMode ? "bg-dark text-white" : "bg-white text-dark";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Resume Preview</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" onclick="window.print();">Print Resume</button>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</div>

<div class="card shadow-sm border-0 @themeClass">
    <div class="card-body p-4">
        <header class="border-bottom pb-3 mb-3">
            <h2 class="h2 mb-1">@Model.FirstName @Model.LastName</h2>
            <p class="mb-1 fw-semibold">@Model.ProfessionalTitle</p>
            <p class="mb-0 text-muted">@Model.Email · @Model.Phone · @Model.Location</p>
        </header>

        <section class="mb-3">
            <h3 class="h5">Professional Summary</h3>
            <p class="mb-0">@Model.ProfessionalSummary</p>
        </section>

        <section class="mb-3">
            <h3 class="h5">Resume Metadata</h3>
            <ul class="mb-0">
                <li>Template: @Model.TemplateType</li>
                <li>Theme: @(Model.IsDarkMode ? "Dark" : "Light")</li>
                <li>LinkedIn: @Model.LinkedInUrl</li>
                <li>GitHub: @Model.GitHubUrl</li>
                <li>Portfolio: @Model.PortfolioUrl</li>
            </ul>
        </section>

        <div class="alert alert-info mb-0">
            Step 1 foundation complete. Next step will add full section editors (skills, experiences, projects, education, certifications, awards, publications, research, references) and export pipeline (PDF/Word).
        </div>
    </div>
</div>
