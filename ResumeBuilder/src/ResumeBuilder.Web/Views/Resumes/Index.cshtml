@model IReadOnlyList<ResumeBuilder.Web.Models.ResumeListItemViewModel>
@{
    ViewData["Title"] = "Resumes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">All Resumes</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="fa-solid fa-plus me-1"></i> New Resume</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="p-4 mb-0 text-muted">No resumes yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Name</th>
                            <th>Professional Title</th>
                            <th>Last Modified</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resume in Model)
                        {
                            <tr>
                                <td>@resume.Title</td>
                                <td>@resume.FullName</td>
                                <td>@resume.ProfessionalTitle</td>
                                <td>@resume.UpdatedUtc.ToString("yyyy-MM-dd")</td>
                                <td class="text-end">
                                    <a asp-action="Preview" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-primary">Preview</a>
                                    <a asp-action="Edit" asp-route-id="@resume.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@resume.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
